# Локальное окружение и IDE
.idea/
.vscode/
.cursor/
*.swp
*~
.DS_Store
Thumbs.db

# Замки открытых документов офисных пакетов. LibreOffice и Word кладут их
# рядом с самим документом, поэтому первый же «git add .» уносит их в
# коммит вместе с материалами заказчика.
.~lock.*#
~$*

# Зависимости и сборка
node_modules/
__pycache__/
*.py[cod]
dist/
build/
out/
bin/
obj/

# Секреты: в репозиторий попадает только перечень переменных
.env
.env.*
!.env.example

# Средства слоя B ставятся локально и не версионируются: замок версий лежит
# в ИНСТРУМЕНТЫ/training-wheels.json, сами файлы регенерируются установкой.
# Раскладываются они в .trip/tools/ — правило ниже их и покрывает.

# Обвязка разработки в репозиторий продукта не входит: методология,
# инструментарий TRIP, его политики и настройки агентов относятся к тому,
# как команда работает, а не к самому решению. Ставятся и обновляются они
# локально командой `trip init`, поэтому версионировать их в продукте нечего.
.trip/
.agents/
.claude/

# Персональные данные и именные материалы в репозиторий не версионируются.

/.cursor/skills/
/.codex/skills/

# Служебные материалы администратора шаблона — в проект не поставляются
ДЛЯ_АДМИНИСТРАТОРА/
МЕТОДОЛОГИЯ/
НАДСТРОЙКА_СТЕКА.md
ПЕРВЫЕ_ШАГИ.md
ИНСТРУМЕНТЫ/

# Рабочие файлы сканера статического анализа: создаются при каждом прогоне.
.sonarqube/

# Среда выполнения и заготовки макетов: инструмент дизайна генерирует их
# заново при каждом выводе макета, поэтому в репозиторий они не входят.
ux/support.js
ux/doc-page.js
ux/image-slot.js
