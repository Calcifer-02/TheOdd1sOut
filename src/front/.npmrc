# Пресеты движков линтера кода (@trip/eslint-config, @trip/prettier-config)
# лежат в реестре пакетов внутреннего GitLab проекта trip-lint, а не в
# публичном npm. Токен берётся из переменной окружения TRIP_TOOLS_TOKEN и в
# файл не попадает: секреты в репозиторий не кладутся, версионируется только
# перечень переменных.
@trip:registry=https://git-internal.imbalanced.tech/api/v4/packages/npm/
//git-internal.imbalanced.tech/api/v4/packages/npm/:_authToken=${TRIP_TOOLS_TOKEN}
