<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Чат-бот платформы MAX (КОМП-07). Общие свойства сборок серверной части
       вынесены в Directory.Build.props рядом: условия трека, разд. 6.1 п. 4
       требуют закреплённых версий, и требование это одно на все сборки. -->

  <ItemGroup>
    <!-- Состояние переписок живёт в общей базе решения (R-080, миграция
         0007). Версии те же, что у расчётной части: две версии одного
         средства доступа к данным в одном решении расходятся. -->
    <PackageReference Include="Dapper" Version="2.1.86" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
