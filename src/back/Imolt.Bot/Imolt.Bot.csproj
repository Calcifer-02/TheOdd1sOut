<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Версии зависимостей фиксируются файлом packages.lock.json: сборка
         в образе идёт в режиме замка (locked mode) и падает, если состав
         изменился без обновления замка. Условия трека, разд. 6.1 п. 4. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
