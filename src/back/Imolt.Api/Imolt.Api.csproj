<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Версии зависимостей фиксируются файлом packages.lock.json: сборка
         в образе идёт в режиме замка (locked mode) и падает, если состав
         изменился без обновления замка. Условия трека, разд. 6.1 п. 4. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- Только страница Swagger UI, без порождения описания из кода: договор
         написан руками и лежит в contracts/openapi.yaml, а средство здесь
         показывает его человеку (ADR-0003). -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Договор едет в образ рядом со сборкой: служба отдаёт тот же файл,
         который лежит в репозитории, а не его копию. -->
    <Content Include="contracts\openapi.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
