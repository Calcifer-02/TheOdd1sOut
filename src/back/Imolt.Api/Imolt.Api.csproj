<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Вход расчётной части (роль «вход» по ADR-0005): хост, состав
       зависимостей, маршруты и переходники между областями. Общие свойства
       сборок — в Directory.Build.props рядом. -->

  <ItemGroup>
    <ProjectReference Include="..\Imolt.Shared\Imolt.Shared.csproj" />
    <ProjectReference Include="..\Imolt.Database\Imolt.Database.csproj" />
    <ProjectReference Include="..\Imolt.References\Imolt.References.csproj" />
    <ProjectReference Include="..\Imolt.Calculations\Imolt.Calculations.csproj" />
    <ProjectReference Include="..\Imolt.Deals\Imolt.Deals.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.86" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Договор едет рядом со сборкой: и при локальном запуске, и в образе он
         лежит в подкаталоге contracts каталога приложения (ADR-0003). -->
    <Content Include="contracts\openapi.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
