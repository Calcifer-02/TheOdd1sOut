# Образец переменных окружения. Скопируйте в .env и подставьте свои значения:
#     cp .env.example .env
# Сам .env в репозиторий не попадает (правило .gitignore и условия трека,
# разд. 4 п. 9: рабочих токенов, паролей и ключей в репозитории быть не должно).

# --- Порты на машине разработчика ------------------------------------------
# Слева от двоеточия в compose.yaml — эти значения, справа — порт внутри
# контейнера. Значения намеренно смещены от привычных 8080, 5173 и 5432:
# на машине разработчика их обычно уже занимает другая служба, и запуск
# падает с «port is already allocated». Меняйте свободно.
API_PORT=18080
BOT_PORT=18081
MINIAPP_PORT=15173
POSTGRES_PORT=15432

# --- База данных -----------------------------------------------------------
# Пароль ниже — заведомо нерабочая заглушка: подставьте собственное значение
# перед первым запуском.
POSTGRES_DB=imolt
POSTGRES_USER=imolt
POSTGRES_PASSWORD=укажите-локальный-пароль

# --- Платформа MAX ---------------------------------------------------------
# Токен чат-бота выдают организаторы хакатона. Пустое значение допустимо:
# службы поднимутся, но обращения к платформе будут невозможны.
MAX_BOT_TOKEN=

# Адрес интерфейса чат-ботов MAX и публичный адрес мини-приложения берутся
# из действующей документации платформы: мини-приложение подключается к MAX
# только по протоколу HTTPS. Значения заполняются при подключении к платформе.
MAX_API_BASE_URL=
MINIAPP_PUBLIC_URL=

# --- Доступ ----------------------------------------------------------------
# Срок давности стартовых параметров мини-приложения в секундах (ADR-0006).
# Договор величину не называет; значение ниже демонстрационное.
MAX_INIT_DATA_TTL_SECONDS=300

# Ключ подписи маркера доступа и срок его жизни в секундах. Пустой ключ
# допустим: служба порождает его при запуске, и тогда маркеры перестают
# действовать после перезапуска. Для стенда задайте собственное значение —
# в репозиторий оно не попадает.
IMOLT_SESSION_SECRET=
IMOLT_SESSION_TTL_SECONDS=86400

# --- Сделка ----------------------------------------------------------------
# Срок действия цены коммерческого предложения в днях (R-038). Длительность
# заказчиком не названа — открытый вопрос Q-010, и значение ниже
# демонстрационное. Настройка одна на ответ операции и на печать в документе:
# два места, считающие срок по-своему, расходятся молча.
QUOTE_VALIDITY_DAYS=7
