{
  "schema_version": 2,
  "description": "Протокол ходунков: средства слоя B — что нужно проекту, откуда берётся и какой версии. Файл описывает получение готовых выпусков, а не копирование исходников инструментов в проект. Единая форма поставки: generic-пакет в реестре репозитория средства, закреплённая версия, отпечаток SHA-256 на каждый файл.",
  "registries": {
    "internal": {
      "label": "Внутренний GitLab",
      "base_url": "https://git-internal.imbalanced.tech",
      "token_env": "TRIP_TOOLS_TOKEN",
      "token_kind_env": "TRIP_TOOLS_TOKEN_KIND",
      "token_kind_default": "deploy",
      "note": "Токен развёртывания создаёт администратор один раз на группу TRIP: единственное право read_package_registry. Личные учётные записи участникам не нужны."
    }
  },
  "install_root": ".trip/tools",
  "tools": [
    {
      "id": "trip-cli",
      "label": "trip",
      "purpose": "Единый вход и git-хуки: тип и направление коммита, ссылка на требование, журнал изменений, имя ветки; реестр средств .trip/tools.",
      "requirement": "обязательное",
      "needed_from_gate": 0,
      "version": "0.7.1",
      "source": {
        "kind": "generic-package",
        "registry": "internal",
        "project": "TRIP/tooling/trip",
        "package": "trip-cli",
        "files": {
          "win-x64": "trip-cli-win-x64.tar.gz",
          "linux-x64": "trip-cli-linux-x64.tar.gz",
          "darwin-arm64": "trip-cli-darwin-arm64.tar.gz"
        }
      },
      "release_state": "выпускается: конвейер по метке v<версия>, публикация ручная",
      "already_installed_check": "trip --version",
      "sha256": {
        "win-x64": "<из harvest.json после публикации 0.7.1>",
        "linux-x64": "<из harvest.json после публикации 0.7.1>",
        "darwin-arm64": "<из harvest.json после публикации 0.7.1>"
