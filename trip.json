{
  "name": "<Имя проекта>",
  "version": "0.1.0",
  "trunk": "main",
  "methodology": {
    "description": "Файл методологии проекта. Управляется trip."
  },
  "policies": {
    "generic": {
      "title": "Обычные изменения",
      "description": "Работа над проектом: менять можно всё, кроме методологии — файла trip.json и содержимого папки trip/. Исключение — настройки средств самого проекта (trip/cast-agreement.json, trip/trace-policy.json): они принадлежат проекту, а не методологии, и правятся здесь.",
      "emblem": "shield",
      "lockMode": "denylist",
      "rules": {
        "add": {
          "deny": [
            {
              "type": "wildcard",
              "pattern": "trip.json"
            },
            {
              "type": "regexp",
              "pattern": "^trip/(?!(?:cast-agreement\\.json|trace-policy\\.json)$).*"
            }
          ]
        },
        "modify": {
          "deny": [
            {
              "type": "wildcard",
              "pattern": "trip.json"
            },
            {
              "type": "regexp",
              "pattern": "^trip/(?!(?:cast-agreement\\.json|trace-policy\\.json)$).*"
            }
          ]
        },
        "delete": {
          "deny": [
            {
              "type": "wildcard",
              "pattern": "trip.json"
            },
            {
              "type": "regexp",
              "pattern": "^trip/(?!(?:cast-agreement\\.json|trace-policy\\.json)$).*"
            }
          ]
        },
        "rename": {
          "deny": [
            {
              "type": "wildcard",
              "pattern": "trip.json"
            },
            {
              "type": "regexp",
              "pattern": "^trip/(?!(?:cast-agreement\\.json|trace-policy\\.json)$).*"
            }
          ]
        }
      },
      "lockZones": [
        {
          "type": "wildcard",
          "pattern": "trip.json"
        },
        {
          "type": "regexp",
          "pattern": "^trip/(?!(?:cast-agreement\\.json|trace-policy\\.json)$).*"
        }
      ],
      "message": {
        "validator": "msg.js"
      },
      "branch": {
        "validator": "branch.js"
      },
      "changelog": {
        "path": "CHANGELOG.md",
        "validator": "changelog.js"
      }
    },
    "policies-only": {
      "title": "Только методология",
      "description": "Правим методологию: разрешено менять лишь файл trip.json и содержимое папки trip/, кроме настроек средств проекта. Остальные файлы заблокированы на запись.",
      "emblem": "shield-check",
      "lockMode": "allowlist",
      "rules": {
        "add": {
          "allow": [
            {
              "type": "wildcard",
              "pattern": "trip.json"
            },
            {
              "type": "regexp",
              "pattern": "^trip/(?!(?:cast-agreement\\.json|trace-policy\\.json)$).*"
            }
          ]
        },
        "modify": {
          "allow": [
            {
              "type": "wildcard",
              "pattern": "trip.json"
            },
            {
              "type": "regexp",
              "pattern": "^trip/(?!(?:cast-agreement\\.json|trace-policy\\.json)$).*"
            }
          ]
        },
        "delete": {
          "allow": [
            {
              "type": "wildcard",
              "pattern": "trip.json"
            },
            {
              "type": "regexp",
              "pattern": "^trip/(?!(?:cast-agreement\\.json|trace-policy\\.json)$).*"
            }
          ]
        },
        "rename": {
          "allow": [
            {
              "type": "wildcard",
              "pattern": "trip.json"
            },
            {
              "type": "regexp",
              "pattern": "^trip/(?!(?:cast-agreement\\.json|trace-policy\\.json)$).*"
            }
          ]
        }
      },
      "lockZones": [
        {
          "type": "wildcard",
          "pattern": "trip.json"
        },
        {
          "type": "regexp",
          "pattern": "^trip/(?!(?:cast-agreement\\.json|trace-policy\\.json)$).*"
        }
      ],
      "message": {
        "validator": "msg.js"
      },
      "branch": {
        "validator": "branch.js"
      },
      "changelog": {
        "path": "CHANGELOG.md",
        "validator": "changelog.js"
      }
    }
  }
}
