{
  "schemaVersion": "trip.trace-policy/v1",
  "mode": "observe",
  "registry": {
    "adapter": "markdown-trip",
    "paths": [
      "docs/ПАКЕТ_АНАЛИТИКИ/РЕЕСТР_ТРЕБОВАНИЙ.md"
    ]
  },
  "artifacts": [],
  "code": {
    "roots": [
      "src"
    ],
    "testRoots": [
      "tests",
      "src/front/tests"
    ],
    "generatedRoots": []
  },
  "languages": {
    "typescript": {
      "enabled": true,
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".mjs",
        ".cjs"
      ]
    },
    "python": {
      "enabled": true,
      "extensions": [
        ".py"
      ]
    },
    "csharp": {
      "enabled": true,
      "extensions": [
        ".cs"
      ]
    }
  },
  "mappings": [],
  "exclusions": []
}
